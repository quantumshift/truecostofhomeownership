# True Cost of Homeownership — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ============================================================
# CLAUDE API (required for the "Estimate costs for this ZIP" utilities feature)
# ============================================================

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# EMAIL DELIVERY (required for "Email me my results")
# ============================================================

# Resend API key — obtain from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address in Resend (must be on a domain you've verified there)
RESEND_FROM_ADDRESS=results@truecostofhomeownership.com

# Where lead notifications go (Kirk's inbox)
LEAD_NOTIFICATION_EMAIL=Kirk@EmpireHomeLoans.com

# ============================================================
# SITE
# ============================================================

NEXT_PUBLIC_SITE_URL=https://truecostofhomeownership.com

# ============================================================
# NOTES
# ============================================================
# - No CRM is wired in yet. Lead notifications currently go out as a plain
#   email to LEAD_NOTIFICATION_EMAIL via Resend. If Kirk wants leads to land
#   directly in a CRM (Follow Up Boss, HubSpot, etc.) instead of/in addition
#   to email, that CRM's API key + list/pipeline ID would go here, and
#   app/api/submit-lead/route.ts would get a second delivery call.
# - Only NEXT_PUBLIC_-prefixed variables are exposed to the browser. Keep
#   ANTHROPIC_API_KEY and RESEND_API_KEY unprefixed so they stay server-only.
